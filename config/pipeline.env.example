# Пайплайн по умолчанию (копировать в .env или export)
CUDA_VISIBLE_DEVICES=0
PYTHON=./venv/bin/python

# Модель продакшена
CLASSIFIER_MODE=ml
CLASSIFIER_PROBE=clip_probe_vlm6_oss.pt
CLASSIFIER_TAXONOMY=6
CLASSIFIER_BACKEND=probe
ML_MIN_CONFIDENCE=0.28
ML_MAX_VIEW_POINTS=5
CLASSIFY_REQUIRE_PANORAMA=1
CLASSIFY_MAX_ROWS=500

# CLIP
CLIP_MODEL=ViT-L-14
CLIP_PRETRAINED=laion2b_s32b_b82k

# Пути данных
DATASET_DIR=data/dataset
ML_PERSPECTIVE_DIR=data/ml_perspective
METADATA_VLM6=data/ml_perspective/metadata_perspective_vlm6_oss.json
CHECKPOINT_DIR=checkpoints
RESULTS_DIR=results

# Тяжёлые шаги (0 = пропуск)
RUN_VLM_RELABEL=0
RUN_PALIGEMMA=0
RUN_AGENT=0
